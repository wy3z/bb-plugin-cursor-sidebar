{
  "compilerOptions": {
    "strict": true,
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "lib": [
      "ES2022",
      "DOM"
    ],
    "types": [
      "node"
    ],
    "paths": {
      "@/*": [
        "./*"
      ],
      "@get-bb/plugin-sdk": [
        "./node_modules/@get-bb/plugin-sdk"
      ],
      "@get-bb/plugin-sdk/app": [
        "./node_modules/@get-bb/plugin-sdk/app"
      ],
      "zod": [
        "./node_modules/zod"
      ]
    },
    "noEmit": true,
    "skipLibCheck": false
  },
  "include": [
    "app.tsx",
    "src",
    "components",
    "lib",
    "hooks"
  ]
}
